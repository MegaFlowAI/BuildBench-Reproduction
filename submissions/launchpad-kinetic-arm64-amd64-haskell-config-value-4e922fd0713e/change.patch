--- a/debian/rules
+++ b/debian/rules
@@ -2,5 +2,12 @@
 
 # DEB_ENABLE_TESTS = yes
 
+# Ubuntu's default LDFLAGS contain -Wl,-Bsymbolic-functions.  When passed to
+# GHC's linker this overrides the -Bsymbolic GHC uses for its dynamic objects,
+# making GHC data closures interposable and breaking the R_X86_64_PC32
+# relocations emitted by the native code generator on amd64.  Strip it from
+# the flags handed to the Haskell build.
+export DEB_LDFLAGS_MAINT_STRIP = -Wl,-Bsymbolic-functions
+
 include /usr/share/cdbs/1/rules/debhelper.mk
 include /usr/share/cdbs/1/class/hlibrary.mk
