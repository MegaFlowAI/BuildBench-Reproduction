--- a/debian/rules
+++ b/debian/rules
@@ -2,5 +2,10 @@
 
 # DEB_ENABLE_TESTS = yes
 
+# Ubuntu's default -Wl,-Bsymbolic-functions is inherited by GHC's shared
+# objects used for Template Haskell; it overrides GHC's own -Bsymbolic and
+# makes the R_X86_64_PC32 relocations in GHC closures fail on amd64.
+export DEB_LDFLAGS_MAINT_STRIP = -Wl,-Bsymbolic-functions
+
 include /usr/share/cdbs/1/rules/debhelper.mk
 include /usr/share/cdbs/1/class/hlibrary.mk
