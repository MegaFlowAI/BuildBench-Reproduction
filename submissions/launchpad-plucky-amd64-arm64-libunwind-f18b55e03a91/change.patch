--- a/debian/rules
+++ b/debian/rules
@@ -5,6 +5,10 @@
 #export DH_VERBOSE=1
 
 export DEB_BUILD_MAINT_OPTIONS = hardening=-all,+format
+# Avoid LTO: on aarch64 the LTO-built libunwind DSO references libgcc's
+# hidden __aarch64_cas8_acq_rel symbol, which breaks linking the test binaries.
+export DEB_CFLAGS_MAINT_APPEND = -fno-lto
+export DEB_LDFLAGS_MAINT_APPEND = -fno-lto
 
 ifneq (,$(filter $(DEB_HOST_ARCH), amd64 i386))
   CXX_EXCEPTIONS=--enable-cxx-exceptions
